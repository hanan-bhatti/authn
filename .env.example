# =============================================================================
# AUTHN - AUTHENTICATION SYSTEM CONFIGURATION
# =============================================================================
# Complete environment configuration for the Authn authentication system
# Version: 1.0.1
# Last Updated: 2025-11-09
#
# IMPORTANT:
#   - Copy this file to .env and configure with your actual values
#   - NEVER commit .env file to version control
#   - Use strong, unique values for all secrets and keys
#   - Minimum 32 characters for JWT_SECRET and SESSION_SECRET
# =============================================================================

# =============================================================================
# 📱 APPLICATION INFORMATION
# =============================================================================
# Basic application metadata and identification

# Application name (displayed in UI, emails, and logs)
APP_NAME=Authn

# Application version (semantic versioning recommended)
APP_VERSION=1.0.0

# Application description (used in meta tags and documentation)
APP_DESCRIPTION=Enterprise-grade authentication and user management system

# Application author/organization
APP_AUTHOR=Your Organization Name

# Support contact email
APP_SUPPORT_EMAIL=support@yourdomain.com

# Terms of Service URL
APP_TERMS_URL=https://yourdomain.com/terms

# Privacy Policy URL
APP_PRIVACY_URL=https://yourdomain.com/privacy

# =============================================================================
# 🌍 ENVIRONMENT & DEPLOYMENT
# =============================================================================

# Application environment (development, staging, production, test)
# - development: Enables debug logs, detailed errors, hot reload
# - staging: Production-like with some debugging enabled
# - production: Optimized, minimal logging, strict security
# - test: For automated testing
NODE_ENV=development

# Deployment mode
# - same-port: Frontend and backend on same port (e.g., localhost:5000)
#   * Uses PORT for both frontend and backend
#   * Simplest setup, ideal for monolithic deployment
#   * Example: Both at http://localhost:5000
# 
# - different-ports: Frontend on one port, backend on another
#   * Frontend uses PORT (e.g., 5000)
#   * Backend uses PORT+1 (e.g., 5001)
#   * Good for development with separate frontend server
#   * Example: Frontend at http://localhost:5000, Backend at http://localhost:5001
#   * IMPORTANT: Configure CORS_ALLOWED_ORIGINS to include both URLs
# 
# - separate-domains: Completely separate domains/URLs
#   * Uses explicitly configured FRONTEND_URL and BASE_URL
#   * Required for production with different domains
#   * Example: Frontend at https://app.example.com, Backend at https://api.example.com
#   * IMPORTANT: Properly configure CORS_ALLOWED_ORIGINS
DEPLOYMENT_MODE=same-port

# =============================================================================
# 🔌 SERVER CONFIGURATION
# =============================================================================

# Base port for the application
# In different-ports mode: Frontend uses this port, Backend uses PORT+1
PORT=3000

# Backend API URL (optional - auto-calculated if not provided)
# Auto-calculated: http://localhost:3001 (PORT+1 in different-ports mode)
# BASE_URL=http://localhost:3001

# Production backend URL
PROD_BASE_URL=https://api.yourdomain.com

# =============================================================================
# 🎨 FRONTEND CONFIGURATION
# =============================================================================

# Frontend URL (optional - auto-calculated if not provided)
# Auto-calculated: http://localhost:3000 (PORT in different-ports mode)
# FRONTEND_URL=http://localhost:3000

# Client URL (legacy, same as FRONTEND_URL)
CLIENT_URL=http://localhost:3000

# Production frontend URL
PROD_FRONTEND_URL=https://yourdomain.com

# Dashboard URL (optional - auto-calculated if not provided)
# Auto-calculated: {FRONTEND_URL}/dashboard
# DASHBOARD_URL=http://localhost:3000/dashboard

# Production dashboard URL
PROD_DASHBOARD_URL=https://yourdomain.com/dashboard

# =============================================================================
# 🗄️ DATABASE CONFIGURATION
# =============================================================================

# MongoDB connection string
# Local example: mongodb://localhost:27017/authn
# Atlas example: mongodb+srv://username:password@cluster.mongodb.net/authn
# Recommended: Use MongoDB Atlas for production
MONGO_URL=mongodb://localhost:27017/authn

# MongoDB options (optional)
MONGO_MAX_POOL_SIZE=10
MONGO_TIMEOUT_MS=5000
MONGO_SOCKET_TIMEOUT_MS=45000

# =============================================================================
# � REDIS CACHE CONFIGURATION
# =============================================================================

# Enable Redis caching (recommended for production)
REDIS_ENABLED=true

# Redis connection URL (default: local Redis on port 6379)
REDIS_URL=redis://localhost:6379

# Redis password (if authentication is enabled)
# REDIS_PASSWORD=your-redis-password

# Connection timeout in milliseconds
REDIS_CONNECT_TIMEOUT=5000

# Session cache TTL in seconds (default: 7 days)
REDIS_SESSION_TTL=604800

# User cache TTL in seconds (default: 1 hour)
REDIS_USER_TTL=3600

# =============================================================================
# 🔐 JWT (JSON Web Token) CONFIGURATION
# =============================================================================

# JWT secret key (CRITICAL - Must be strong and unique)
# Minimum: 32 characters
# Recommended: 64+ characters
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-CHANGE-THIS

# JWT algorithm selection
# Options: HS256 (symmetric), HS384, HS512, RS256 (asymmetric), RS384, RS512
#   - HS256: Fastest, most common (recommended for most apps)
#   - HS512: More secure, slightly slower
#   - RS256: Asymmetric, more complex, needed for multi-service architectures
JWT_ALGORITHM=HS256

# JWT token expiration
# Format: number + unit (s=seconds, m=minutes, h=hours, d=days)
# Default: 7d (7 days)
# Recommended: 7d for regular sessions, 30d with remember-me
JWT_EXPIRES_IN=7d

# JWT issuer (identifies who issued the token)
JWT_ISSUER=authn-auth-system

# JWT audience (identifies who the token is for)
JWT_AUDIENCE=authn-users

# Refresh token expiration (if implementing refresh tokens)
JWT_REFRESH_EXPIRES_IN=30d

# RSA keys for RS256/RS384/RS512 algorithms (only if using asymmetric)
# Generate keys:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# =============================================================================
# 🍪 SESSION & COOKIE CONFIGURATION
# =============================================================================

# Session secret (for session-based features)
# Must be different from JWT_SECRET
# Minimum: 32 characters
SESSION_SECRET=your-session-secret-key-min-32-chars-CHANGE-THIS

# Cookie configuration
# httpOnly: Prevents JavaScript access (security feature)
COOKIE_HTTP_ONLY=true

# secure: Only send cookies over HTTPS (set to true in production)
COOKIE_SECURE=false

# sameSite: CSRF protection
# Options: strict, lax, none
#   - strict: Most secure, may affect cross-site functionality
#   - lax: Good balance (recommended)
#   - none: Least secure, only if needed for cross-site
COOKIE_SAME_SITE=lax

# Cookie max age in milliseconds
# Default: 604800000 (7 days)
# With remember-me: 2592000000 (30 days)
COOKIE_MAX_AGE=604800000

# Cookie path
COOKIE_PATH=/

# Cookie domain (leave empty for same domain)
# COOKIE_DOMAIN=.yourdomain.com

# =============================================================================
# 🔒 SECURITY CONFIGURATION
# =============================================================================

# Bcrypt password hashing rounds
# Higher = more secure but slower
# Recommended: 12-14 for production
# Range: 10-14 (10=fast, 14=very secure)
BCRYPT_ROUNDS=12

# Encryption key for sensitive data (32 bytes hex)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-64-char-encryption-key-here

# Account security settings
# Maximum failed login attempts before account lock
AUTH_MAX_LOGIN_ATTEMPTS=10

# Account lock duration in milliseconds (default: 30 minutes)
AUTH_ACCOUNT_LOCK_DURATION=1800000

# Maximum 2FA failed attempts before lock
AUTH_MAX_2FA_ATTEMPTS=5

# 2FA lock duration in milliseconds (default: 15 minutes)
AUTH_2FA_LOCK_DURATION=900000

# Password reset token expiry (in milliseconds)
# Default: 1800000 (30 minutes)
PASSWORD_RESET_EXPIRY=1800000

# Email verification OTP expiry (in milliseconds)
# Default: 600000 (10 minutes)
EMAIL_VERIFICATION_EXPIRY=600000

# Device verification token expiry (in milliseconds)
# Default: 86400000 (24 hours)
DEVICE_VERIFICATION_EXPIRY=86400000

# Maximum trusted devices per user
MAX_TRUSTED_DEVICES=10

# Maximum active sessions per user
MAX_ACTIVE_SESSIONS=5

# Session activity timeout (auto logout after inactivity)
# Default: 3600000 (1 hour), 0 to disable
SESSION_ACTIVITY_TIMEOUT=3600000

# =============================================================================
# 🚦 RATE LIMITING CONFIGURATION
# =============================================================================

# Global API rate limiting
# Requests per window for all endpoints (except auth)
RATE_LIMIT_MAX_REQUESTS=1000

# Global rate limit window in milliseconds
# Default: 900000 (15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# Authentication endpoints rate limiting
# Maximum authentication attempts per window
AUTH_RATE_LIMIT_MAX_REQUESTS=5

# Authentication rate limit window in milliseconds
# Default: 900000 (15 minutes)
AUTH_RATE_LIMIT_WINDOW_MS=900000

# Rate limit skip paths (comma-separated, no spaces)
# Endpoints that bypass rate limiting
RATE_LIMIT_SKIP_PATHS=/health,/api/health

# Custom rate limit message
RATE_LIMIT_MESSAGE=Too many requests from this IP, please try again later

# =============================================================================
# 🌐 CORS (Cross-Origin Resource Sharing) CONFIGURATION
# =============================================================================

# Allowed origins (comma-separated, no spaces)
# NOTE: This is AUTO-CONFIGURED based on DEPLOYMENT_MODE:
#   - same-port: Uses calculated BASE_URL
#   - different-ports: Includes both frontend and backend URLs
#   - separate-domains: Uses FRONTEND_URL
# 
# Manual configuration (overrides auto-config):
#   - Development: http://localhost:3000,http://localhost:5000
#   - Production: https://yourdomain.com,https://api.yourdomain.com
# 
# Leave empty or comment out to use auto-configuration
CORS_ALLOWED_ORIGINS=http://localhost:5000,http://localhost:3000

# CORS credentials (allow cookies/auth headers)
CORS_ALLOW_CREDENTIALS=true

# CORS allowed methods
CORS_ALLOWED_METHODS=GET,HEAD,OPTIONS,POST,PUT,DELETE,PATCH

# CORS allowed headers
CORS_ALLOWED_HEADERS=Origin,X-Requested-With,Content-Type,Accept,Authorization,X-API-Key

# CORS max age (preflight cache duration in seconds)
CORS_MAX_AGE=86400

# =============================================================================
# 📧 EMAIL / SMTP CONFIGURATION
# =============================================================================

# SMTP server host
# Examples:
#   - Gmail: smtp.gmail.com
#   - Outlook: smtp.office365.com
#   - SendGrid: smtp.sendgrid.net
#   - Mailgun: smtp.mailgun.org
#   - Custom: mail.yourdomain.com
SMTP_HOST=smtp.gmail.com

# SMTP port
# Common ports:
#   - 587: TLS/STARTTLS (recommended)
#   - 465: SSL (deprecated but still used)
#   - 25: Unencrypted (not recommended)
SMTP_PORT=587

# SMTP username (usually your email address)
SMTP_USER=your-email@gmail.com

# SMTP password / App password
# For Gmail: Generate app-specific password from account settings
# For SendGrid: Use API key
SMTP_PASS=your-smtp-password-or-app-password

# Email "From" address (shown to recipients)
EMAIL_FROM=noreply@yourdomain.com

# Email "From" name (friendly name shown to recipients)
EMAIL_FROM_NAME=Authn Auth System

# SMTP secure connection (true for SSL, false for TLS)
SMTP_SECURE=false

# Enable/disable email service
# Set to false to disable all email functionality (for testing)
EMAIL_ENABLED=true

# Email template configuration
EMAIL_LOGO_URL=https://yourdomain.com/logo.png
EMAIL_PRIMARY_COLOR=#2563eb
EMAIL_COMPANY_NAME=Your Company
EMAIL_COMPANY_ADDRESS=123 Main St, City, Country

# =============================================================================
# 🔑 SOCIAL LOGIN CONFIGURATION
# =============================================================================

# Enable/disable social login providers
SOCIAL_LOGIN_ENABLED=true

# ---------- Google OAuth 2.0 ----------
GOOGLE_AUTH_ENABLED=true
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ---------- Facebook OAuth 2.0 ----------
FACEBOOK_AUTH_ENABLED=false
FACEBOOK_CLIENT_ID=your-facebook-app-id
FACEBOOK_CLIENT_SECRET=your-facebook-app-secret
FACEBOOK_CALLBACK_URL=http://localhost:5000/api/auth/facebook/callback

# ---------- GitHub OAuth 2.0 ----------
GITHUB_AUTH_ENABLED=false
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback

# ---------- Twitter OAuth 2.0 ----------
TWITTER_AUTH_ENABLED=false
TWITTER_CLIENT_ID=your-twitter-client-id
TWITTER_CLIENT_SECRET=your-twitter-client-secret
TWITTER_CALLBACK_URL=http://localhost:5000/api/auth/twitter/callback

# ---------- LinkedIn OAuth 2.0 ----------
LINKEDIN_AUTH_ENABLED=false
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
LINKEDIN_CALLBACK_URL=http://localhost:5000/api/auth/linkedin/callback

# =============================================================================
# 📦 AWS S3 FILE STORAGE CONFIGURATION
# =============================================================================

# Enable/disable file storage
FILE_STORAGE_ENABLED=true

# Storage service provider
# Options: s3, local
#   - s3: Amazon S3 or S3-compatible services (recommended for production)
#   - local: Local file system (development only, not for production)
STORAGE_SERVICE=s3

# ---------- AWS S3 Core Configuration ----------

# AWS Access Key ID (REQUIRED for S3)
# Get from AWS IAM Console: https://console.aws.amazon.com/iam/
# Best practice: Create a dedicated IAM user for your application
# Required permissions: s3:PutObject, s3:GetObject, s3:DeleteObject, s3:ListBucket
AWS_ACCESS_KEY_ID=your-aws-access-key-id

# AWS Secret Access Key (REQUIRED for S3)
# Keep this secret! Never commit to version control
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# S3 Bucket Name (REQUIRED)
# Must be globally unique across all AWS accounts
# Naming rules: lowercase, no spaces, 3-63 characters
# Example: my-app-production-files
AWS_S3_BUCKET_NAME=your-s3-bucket-name

# Alternative bucket name variable (for flexibility)
AWS_S3_BUCKET=your-s3-bucket-name

# AWS Region
# Default: us-east-1
# Other regions: us-west-2, eu-west-1, ap-southeast-1, etc.
# Choose region closest to your users for better performance
# Full list: https://docs.aws.amazon.com/general/latest/gr/s3.html
AWS_S3_REGION=us-east-1

# ---------- S3 Advanced Configuration ----------

# Custom S3 endpoint (for S3-compatible services)
# Leave empty for standard AWS S3
# Examples:
#   - DigitalOcean Spaces: https://nyc3.digitaloceanspaces.com
#   - Wasabi: https://s3.wasabisys.com
#   - MinIO: http://localhost:9000
#   - Backblaze B2: https://s3.us-west-001.backblazeb2.com
# AWS_S3_ENDPOINT=https://s3.your-custom-endpoint.com

# Force path style (for S3-compatible services)
# Default: false (uses virtual-hosted-style: bucket.s3.region.amazonaws.com)
# Set to true for path-style: s3.region.amazonaws.com/bucket
# Required for some S3-compatible services like MinIO
AWS_S3_FORCE_PATH_STYLE=false

# Default ACL (Access Control List) for uploaded files
# Options:
#   - private: Only owner can access (requires signed URLs)
#   - public-read: Anyone can read, only owner can write (most common)
#   - public-read-write: Anyone can read and write (not recommended)
#   - authenticated-read: Only authenticated AWS users can read
# Default: public-read
AWS_S3_DEFAULT_ACL=public-read

# ---------- CDN Configuration (Optional but Recommended) ----------

# Enable CDN for faster content delivery
# Default: false
# Set to true when using CloudFront or other CDN
AWS_S3_USE_CDN=false
USE_CDN=false

# CDN URL (CloudFront or custom CDN)
# Examples:
#   - CloudFront: https://d1234567890.cloudfront.net
#   - Custom domain: https://cdn.yourdomain.com
# Leave empty if not using CDN
# AWS_S3_CDN_URL=https://d1234567890.cloudfront.net
# CDN_URL=https://cdn.yourdomain.com

# CloudFront Distribution ID (for cache invalidation)
# Optional: Only needed if you want to programmatically invalidate cache
# AWS_CLOUDFRONT_DISTRIBUTION_ID=E1234567890ABC

# ---------- File Upload Limits ----------

# Maximum file size in bytes
# Default: 52428800 (50MB)
# Examples:
#   - 10MB: 10485760
#   - 50MB: 52428800
#   - 100MB: 104857600
#   - 500MB: 524288000
MAX_FILE_SIZE=52428800

# Allowed file types (comma-separated MIME types)
# Image formats
ALLOWED_FILE_TYPES=image/jpeg,image/jpg,image/png,image/webp,image/svg+xml,image/gif,image/bmp,image/tiff,video/mp4,video/mpeg,video/quicktime,video/webm,audio/mpeg,audio/wav,audio/mp3,audio/ogg,application/pdf,text/plain,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/zip,application/x-rar-compressed

# ---------- Image Processing Configuration ----------

# Enable automatic image optimization
# Reduces file size while maintaining quality
IMAGE_OPTIMIZATION_ENABLED=true

# Image quality (1-100)
# Default: 85
# Recommended: 80-90 for web use
# Higher = better quality, larger file size
IMAGE_QUALITY=85

# Image format for processed images
# Options: webp, jpeg, png
# Recommended: webp (best compression, wide browser support)
IMAGE_FORMAT=webp

# Generate multiple image sizes
# Creates thumbnail, small, medium, large variants
IMAGE_GENERATE_SIZES=true

# Custom image sizes (optional)
# Format: width,height,quality,name
# Example: 100,100,80,tiny|200,200,85,small|400,400,90,medium
# Leave empty to use defaults
# IMAGE_CUSTOM_SIZES=

# Image size presets (automatically generated)
# Default sizes:
#   - thumbnail: 32x32 (for icons, badges)
#   - icon: 64x64 (for user avatars in lists)
#   - small: 128x128 (for small profile pictures)
#   - medium: 256x256 (for default profile pictures)
#   - large: 512x512 (for large profile pictures)
#   - xlarge: 1024x1024 (for full resolution)
#   - cover: 1920x1080 (for cover images, banners)

# Maintain aspect ratio when resizing
# true: Crop to fit (cover mode)
# false: Stretch to fit (may distort)
IMAGE_MAINTAIN_ASPECT_RATIO=true

# Upload original image (unprocessed)
# true: Keep original file along with variants
# false: Only store processed variants (saves space)
IMAGE_UPLOAD_ORIGINAL=true

# ---------- File Organization ----------

# User file organization structure
# Files are automatically organized as: users/{userId}/{folder}/{size}/{filename}
# Default folders:
#   - profile: Profile pictures and avatars
#   - documents: User documents (PDF, DOC, etc.)
#   - uploads: General file uploads
#   - media: Videos and audio files
#   - attachments: Email/message attachments

# ---------- S3 Transfer Acceleration (Optional) ----------

# Enable S3 Transfer Acceleration for faster uploads
# Note: Additional charges apply
# S3_TRANSFER_ACCELERATION=false

# ---------- S3 Versioning (Optional) ----------

# Enable object versioning for backup/recovery
# S3_VERSIONING_ENABLED=false

# ---------- S3 Lifecycle Rules (Optional) ----------

# Automatically transition old files to cheaper storage classes
# S3_LIFECYCLE_ENABLED=false
# S3_LIFECYCLE_TRANSITION_DAYS=90
# S3_LIFECYCLE_STORAGE_CLASS=STANDARD_IA

# ---------- Logging Configuration ----------

# Enable detailed S3 operation logging
# Useful for debugging upload/download issues
S3_LOGGING_ENABLED=true

# Log S3 request/response details
# Warning: May expose sensitive data in logs
S3_LOG_REQUESTS=false

# =============================================================================
# 💾 BACKUP CONFIGURATION
# =============================================================================

# Enable/disable automatic user backups
BACKUP_ENABLED=true

# Backup storage path (relative or absolute)
BACKUP_PATH=./backups

# Backup retention period in days
BACKUP_RETENTION_DAYS=365

# Enable backup compression (gzip)
BACKUP_COMPRESSION_ENABLED=true

# Enable backup encryption (AES-256)
BACKUP_ENCRYPTION_ENABLED=true

# Backup encryption key (32 bytes hex)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BACKUP_ENCRYPTION_KEY=your-backup-encryption-key

# Automatic backup schedule (cron format)
# Default: Daily at 2 AM
BACKUP_CRON_SCHEDULE=0 2 * * *

# Backup to S3 (optional)
# Store backups in S3 for redundancy
BACKUP_TO_S3=false
BACKUP_S3_BUCKET=your-backup-bucket-name
BACKUP_S3_PREFIX=backups/

# =============================================================================
# 🎨 THEME & WEATHER API
# =============================================================================

# Enable dynamic theme based on weather/events
DYNAMIC_THEME_ENABLED=true

# OpenWeather API key (for weather-based themes)
# Get free key at: https://openweathermap.org/api
OPENWEATHER_API_KEY=your-openweather-api-key

# Alternative weather API
# WEATHER_API_KEY=your-weather-api-key

# Calendarific API key (for Islamic/Pakistani event themes)
# Get free key at: https://calendarific.com
CALENDARIFIC_API_KEY=your-calendarific-api-key

# Default location for weather (city name or coordinates)
DEFAULT_WEATHER_LOCATION=Islamabad
DEFAULT_WEATHER_LAT=33.6844
DEFAULT_WEATHER_LON=73.0479

# =============================================================================
# 🛡️ DEVICE FINGERPRINTING & SECURITY
# =============================================================================

# Enable device fingerprinting
DEVICE_FINGERPRINTING_ENABLED=true

# Device fingerprint components (comma-separated)
# Options: userAgent, platform, language, screenResolution, timezone, browser, os, ip, geolocation
DEVICE_FINGERPRINT_COMPONENTS=userAgent,platform,screenResolution,timezone,ip,geolocation

# Bypass device verification (for development/testing)
# WARNING: Set to false in production
BYPASS_DEVICE_VERIFICATION=false

# Enable IP-based geolocation
GEOLOCATION_ENABLED=true

# GeoIP service (geoip-lite, maxmind, ip-api)
GEOLOCATION_SERVICE=geoip-lite

# MaxMind GeoIP license key (if using maxmind)
# MAXMIND_LICENSE_KEY=your-maxmind-key

# Enable new device email notifications
NEW_DEVICE_EMAIL_NOTIFICATION=true

# =============================================================================
# 🔐 TWO-FACTOR AUTHENTICATION (2FA)
# =============================================================================

# Enable 2FA feature
TWO_FACTOR_AUTH_ENABLED=true

# 2FA issuer name (shown in authenticator apps)
TWO_FACTOR_ISSUER=Authn

# Number of backup codes to generate
TWO_FACTOR_BACKUP_CODES_COUNT=10

# Backup code length
TWO_FACTOR_BACKUP_CODE_LENGTH=8

# TOTP window (time steps to check, default: 1)
# Higher = more lenient but less secure
TWO_FACTOR_TOTP_WINDOW=1

# TOTP step (seconds per time step, default: 30)
TWO_FACTOR_TOTP_STEP=30

# =============================================================================
# 📊 LOGGING & MONITORING
# =============================================================================

# Enable detailed logging
LOGGING_ENABLED=true

# Log level (error, warn, info, debug, verbose)
#   - production: error or warn
#   - development: debug or verbose
LOG_LEVEL=debug

# Log format (json, simple, combined)
LOG_FORMAT=json

# Enable request logging
LOG_REQUESTS=true

# Log file path (leave empty to disable file logging)
LOG_FILE_PATH=./logs/app.log

# Maximum log file size in bytes
LOG_MAX_FILE_SIZE=10485760

# Maximum number of log files to keep
LOG_MAX_FILES=10

# Enable error tracking (Sentry, etc.)
ERROR_TRACKING_ENABLED=false
# SENTRY_DSN=your-sentry-dsn

# Enable performance monitoring
PERFORMANCE_MONITORING_ENABLED=false

# =============================================================================
# 🚧 MAINTENANCE MODE
# =============================================================================

# Enable maintenance mode (blocks all requests except admin)
MAINTENANCE_MODE=false

# Maintenance mode message
MAINTENANCE_MESSAGE=System under maintenance. Please try again later.

# Retry after (seconds)
MAINTENANCE_RETRY_AFTER=3600

# =============================================================================
# ✨ FEATURE FLAGS
# =============================================================================

# Enable user registration
FEATURE_REGISTRATION_ENABLED=true

# Enable password reset
FEATURE_PASSWORD_RESET_ENABLED=true

# Enable email verification
FEATURE_EMAIL_VERIFICATION_ENABLED=true

# Require email verification for login
FEATURE_REQUIRE_EMAIL_VERIFICATION=true

# Enable profile picture upload
FEATURE_PROFILE_PICTURE_ENABLED=true

# Enable location features
FEATURE_LOCATION_ENABLED=true

# Enable social account linking
FEATURE_SOCIAL_LINKING_ENABLED=true

# Enable device management
FEATURE_DEVICE_MANAGEMENT_ENABLED=true

# Enable session management
FEATURE_SESSION_MANAGEMENT_ENABLED=true

# Enable audit logs
FEATURE_AUDIT_LOGS_ENABLED=true

# Enable analytics
FEATURE_ANALYTICS_ENABLED=true

# Enable notifications
FEATURE_NOTIFICATIONS_ENABLED=true

# Enable API keys
FEATURE_API_KEYS_ENABLED=false

# Enable WebAuthn / Passkeys
FEATURE_WEBAUTHN_ENABLED=false

# Enable magic link authentication
FEATURE_MAGIC_LINK_ENABLED=false

# =============================================================================
# 🧪 DEVELOPMENT & DEBUGGING
# =============================================================================

# Enable development mode features
DEV_MODE=true

# Enable GraphQL playground (if implementing GraphQL)
GRAPHQL_PLAYGROUND_ENABLED=false

# Enable API documentation (Swagger/OpenAPI)
API_DOCS_ENABLED=true

# API documentation path
API_DOCS_PATH=/api/docs

# Enable CORS for all origins (development only)
DEV_CORS_ALL_ORIGINS=true

# Disable rate limiting in development
DEV_DISABLE_RATE_LIMITING=false

# Enable detailed error messages
DEV_DETAILED_ERRORS=true

# Enable SQL query logging (if using SQL)
# DEV_LOG_QUERIES=true

# Seed database with test data
DEV_SEED_DATABASE=false

# =============================================================================
# 🎯 ADVANCED CONFIGURATION
# =============================================================================

# Timezone (for server-side operations)
TZ=UTC

# Default user role for new registrations
DEFAULT_USER_ROLE=user

# Default language
DEFAULT_LANGUAGE=en

# Supported languages (comma-separated)
SUPPORTED_LANGUAGES=en,es,fr,de,it,pt,ru,zh,ja,ko

# Default timezone for users
DEFAULT_TIMEZONE=UTC

# Date format (ISO, US, EU)
DATE_FORMAT=ISO

# Enable webhook support
WEBHOOKS_ENABLED=false

# Webhook secret for signature verification
# WEBHOOK_SECRET=your-webhook-secret

# Enable GraphQL API
GRAPHQL_ENABLED=false

# GraphQL path
GRAPHQL_PATH=/graphql

# Enable REST API versioning
API_VERSIONING_ENABLED=false

# Default API version
API_VERSION=v1

# Max request body size (for uploads)
MAX_REQUEST_SIZE=50mb

# Request timeout (milliseconds)
REQUEST_TIMEOUT=30000

# Enable compression
COMPRESSION_ENABLED=true

# Compression level (0-9, 9=max compression)
COMPRESSION_LEVEL=6

# Enable HTTP/2
HTTP2_ENABLED=false

# =============================================================================
# 🔍 SEARCH & INDEXING
# =============================================================================

# Enable search functionality
SEARCH_ENABLED=false

# Search service (mongodb, elasticsearch, algolia)
SEARCH_SERVICE=mongodb

# Elasticsearch configuration (if using elasticsearch)
# ELASTICSEARCH_URL=http://localhost:9200
# ELASTICSEARCH_INDEX=authn

# Algolia configuration (if using algolia)
# ALGOLIA_APP_ID=your-app-id
# ALGOLIA_API_KEY=your-api-key
# ALGOLIA_INDEX=authn

# =============================================================================
# 📱 MOBILE APP CONFIGURATION
# =============================================================================

# Enable mobile app support
MOBILE_APP_ENABLED=false

# iOS App Store URL
# IOS_APP_URL=https://apps.apple.com/app/your-app

# Android Play Store URL
# ANDROID_APP_URL=https://play.google.com/store/apps/details?id=your.app

# Deep linking scheme
# DEEP_LINK_SCHEME=authn

# =============================================================================
# 🌐 INTERNATIONALIZATION (i18n)
# =============================================================================

# Enable internationalization
I18N_ENABLED=true

# Default locale
DEFAULT_LOCALE=en

# Fallback locale
FALLBACK_LOCALE=en

# Supported locales (comma-separated)
SUPPORTED_LOCALES=en,es,fr,de,it,pt,ru,zh,ja,ko,ar,ur

# =============================================================================
# 💳 PAYMENT INTEGRATION (Future Feature)
# =============================================================================

# Enable payment processing
PAYMENTS_ENABLED=false

# Payment provider (stripe, paypal, paddle)
# PAYMENT_PROVIDER=stripe

# Stripe configuration
# STRIPE_PUBLIC_KEY=pk_test_...
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# =============================================================================
# 📞 SMS/PHONE VERIFICATION (Future Feature)
# =============================================================================

# Enable SMS functionality
SMS_ENABLED=false

# SMS provider (twilio, vonage, aws-sns)
# SMS_PROVIDER=twilio

# Twilio configuration
# TWILIO_ACCOUNT_SID=your-account-sid
# TWILIO_AUTH_TOKEN=your-auth-token
# TWILIO_PHONE_NUMBER=+1234567890

# =============================================================================
# 🤖 SECURITY HEADERS
# =============================================================================

# Content Security Policy (CSP)
CSP_ENABLED=true
CSP_DIRECTIVES={"defaultSrc":["'self'"],"scriptSrc":["'self'","'unsafe-inline'"],"styleSrc":["'self'","'unsafe-inline'"],"imgSrc":["'self'","data:","https://*.myfilebase.com","https://img.shields.io","https://contrib.rocks"]}

# X-Frame-Options
X_FRAME_OPTIONS=DENY

# X-Content-Type-Options
X_CONTENT_TYPE_OPTIONS=nosniff

# X-XSS-Protection
X_XSS_PROTECTION=1; mode=block

# Referrer-Policy
REFERRER_POLICY=no-referrer-when-downgrade

# =============================================================================
# 📈 ANALYTICS & TRACKING
# =============================================================================

# Enable analytics
ANALYTICS_ENABLED=false

# Google Analytics ID
# GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# Enable user tracking
USER_TRACKING_ENABLED=false

# Enable error reporting
ERROR_REPORTING_ENABLED=false

# =============================================================================
# END OF CONFIGURATION
# =============================================================================
# 
# SECURITY CHECKLIST FOR PRODUCTION:
# ✓ Change all default secrets and keys
# ✓ Set NODE_ENV=production
# ✓ Enable HTTPS and set COOKIE_SECURE=true
# ✓ Configure proper CORS_ALLOWED_ORIGINS
# ✓ Set strong BCRYPT_ROUNDS (12-14)
# ✓ Enable rate limiting with appropriate limits
# ✓ Review and configure all security settings
# ✓ Set up proper logging and monitoring
# ✓ Configure backup and retention policies
# ✓ Review feature flags and disable unnecessary features
# ✓ Set up proper email service (not Gmail for production)
# ✓ Configure production database with authentication
# ✓ Enable and configure SSL/TLS certificates
# ✓ Set up proper firewall rules
# ✓ Review and test all authentication flows
# ✓ Enable and test backup/restore procedures
# ✓ Regularly update dependencies and monitor for vulnerabilities
# ✓ Configure AWS S3 with proper IAM permissions
# ✓ Enable S3 bucket encryption and versioning
# ✓ Set up CloudFront CDN for better performance
# ✓ Configure S3 bucket policies for security
# ✓ Enable S3 access logging for audit trails